# CHOG / MON-USDC local runtime config example.
# Copy to .env.chog.local for this private workspace and fill real secrets there.

CHOG_DATA_ROOT="data/chog/v1"

# Monad RPC examples. Keep real keys only in .env.chog.local.
CHOG_ALCHEMY_LOG_RPCS=(
  "https://monad-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"
)
ALCHEMY_RPC="https://monad-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"

CHOG_LOG_RANGE_BLOCKS=1000
CHOG_HEADER_RPC="https://rpc1.monad.xyz"

# Tardis historical market data API.
# Current local key may be academic/options-only; run:
#   python scripts\tardis_access_probe.py --env-file .env.chog.local
TARDIS_API_KEY="YOUR_TARDIS_API_KEY"

CHOG_PUBLIC_LOG_RPCS=(
  "https://rpc.monad.xyz"
  "https://rpc1.monad.xyz"
  "https://rpc2.monad.xyz"
  "https://rpc3.monad.xyz"
  "https://monad-mainnet.drpc.org"
  "https://rpc-mainnet.monadinfra.com"
  "https://monad-rpc.huginn.tech"
  "https://monad.gateway.tenderly.co"
)

CHOG_LOG_RPCS=(
  "${CHOG_ALCHEMY_LOG_RPCS[@]}"
  "${CHOG_PUBLIC_LOG_RPCS[@]}"
)
