    callback navigate(string); callback create-run(); callback open-run(string); callback select-run(string); callback run-backtest(); callback choose-fill-model(string); callback choose-strategy(string); callback replay-command(string); callback seek(float); callback select-fill(string); callback select-tab(string);
    HorizontalLayout {
        Rectangle { width: 214px; background: Palette.shell; VerticalLayout { padding: 17px; spacing: 7px; Text { text: "QRS"; color: Palette.amber; font-size: 22px; font-weight: 900; } Text { text: "QUANT REPLAY STUDIO"; color: Palette.text; font-size: 10px; font-weight: 800; letter-spacing: 1px; } Text { text: "RUNNER ARTIFACT MONITOR"; color: Palette.dim; font-size: 8px; letter-spacing: 1px; } Rectangle { height: 22px; } Nav { label: "Run Library"; note: "recent runs · open story"; active: root.current-page == "library"; clicked => root.navigate("library"); } Nav { label: "Backtest Setup"; note: "dataset · strategy · execution"; active: root.current-page == "setup"; clicked => root.navigate("setup"); } Nav { label: "Replay Workbench"; note: "signal · fill · PnL"; active: root.current-page == "workbench"; clicked => root.navigate("workbench"); } Rectangle { vertical-stretch: 1; } Text { text: root.status-message; color: Palette.dim; font-size: 8px; } Text { text: "SELECTED RUN"; color: Palette.dim; font-size: 7px; letter-spacing: 1px; } Copy { value: root.selected-run-id; } } }
        Rectangle { horizontal-stretch: 1; if root.current-page == "library": RunLibraryPage { run-count: root.run-count; run-root: root.run-root; run-1-id: root.run-1-id; run-1-dataset: root.run-1-dataset; run-1-symbol: root.run-1-symbol; run-1-strategy: root.run-1-strategy; run-1-stats: root.run-1-stats; run-1-status: root.run-1-status; run-2-id: root.run-2-id; run-2-dataset: root.run-2-dataset; run-2-symbol: root.run-2-symbol; run-2-strategy: root.run-2-strategy; run-2-stats: root.run-2-stats; run-2-status: root.run-2-status; run-3-id: root.run-3-id; run-3-dataset: root.run-3-dataset; run-3-symbol: root.run-3-symbol; run-3-strategy: root.run-3-strategy; run-3-stats: root.run-3-stats; run-3-status: root.run-3-status; run-4-id: root.run-4-id; run-4-dataset: root.run-4-dataset; run-4-symbol: root.run-4-symbol; run-4-strategy: root.run-4-strategy; run-4-stats: root.run-4-stats; run-4-status: root.run-4-status; run-5-id: root.run-5-id; run-5-dataset: root.run-5-dataset; run-5-symbol: root.run-5-symbol; run-5-strategy: root.run-5-strategy; run-5-stats: root.run-5-stats; run-5-status: root.run-5-status; run-6-id: root.run-6-id; run-6-dataset: root.run-6-dataset; run-6-symbol: root.run-6-symbol; run-6-strategy: root.run-6-strategy; run-6-stats: root.run-6-stats; run-6-status: root.run-6-status; open-run(value) => root.open-run(value); create-run => root.create-run(); select-run(value) => root.select-run(value); } if root.current-page == "setup": SetupPage { dataset-status: root.dataset-status; l2-quality: root.l2-quality; raw-size: root.raw-size; fill-model: root.fill-model; strategy-profile: root.strategy-profile; run-state: root.run-state; run-phase: root.run-phase; run-detail: root.run-detail; run-backtest => root.run-backtest(); choose-fill-model(value) => root.choose-fill-model(value); choose-strategy(value) => root.choose-strategy(value); } if root.current-page == "workbench": WorkbenchPage { run-id: root.run-id; symbol: root.symbol; dataset-date: root.dataset-date; strategy-name: root.strategy-name; execution-model: root.execution-model; replay-time: root.replay-time; event-cursor: root.event-cursor; replay-state: root.replay-state; replay-progress: root.replay-progress; mid: root.mid; best-bid: root.best-bid; best-ask: root.best-ask; spread: root.spread; microprice: root.microprice; signal: root.signal; chart: root.chart; order-book: root.order-book; event-tape: root.event-tape; orders-text: root.orders-text; fills-text: root.fills-text; position-text: root.position-text; pnl-text: root.pnl-text; causal-text: root.causal-text; l2-warning: root.l2-warning; raw-event: root.raw-event; selected-fill: root.selected-fill; trade-summary: root.trade-summary; trade-detail: root.trade-detail; signal-story: root.signal-story; arrival-story: root.arrival-story; execution-story: root.execution-story; account-story: root.account-story; open-library => root.navigate("library"); open-setup => root.navigate("setup"); replay-command(value) => root.replay-command(value); seek(value) => root.seek(value); select-fill(value) => root.select-fill(value); select-tab(value) => root.select-tab(value); } }
    }
}
