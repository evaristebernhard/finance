{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy_intent_v1",
  "type": "object",
  "required": ["type", "side", "kind", "qty", "tif"],
  "properties": {
    "type": { "const": "submit_order" },
    "client_order_id": { "type": ["string", "null"] },
    "side": { "enum": ["buy", "sell"] },
    "kind": { "enum": ["market", "limit"] },
    "qty": { "type": "number", "exclusiveMinimum": 0 },
    "limit_price": { "type": ["number", "null"] },
    "tif": { "enum": ["ioc", "gtc"] },
    "reduce_only": { "type": "boolean" },
    "execution_role": { "enum": ["taker", "maker_reserved"] },
    "post_only": { "type": "boolean" },
    "maker_profile_id": { "type": ["string", "null"] },
    "queue_model_id": { "type": ["string", "null"] },
    "max_rest_us": { "type": ["integer", "null"], "minimum": 0 },
    "queue_reservation_id": { "type": ["string", "null"] },
    "observed_seq": { "type": ["integer", "null"], "minimum": 0 },
    "reason": { "type": ["string", "null"] }
  }
}
