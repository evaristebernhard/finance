{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l2_level_update_v1",
  "type": "object",
  "required": ["seq", "exchange_ts_us", "local_ts_us", "is_snapshot", "side", "price", "qty"],
  "properties": {
    "seq": { "type": "integer", "minimum": 0 },
    "exchange_ts_us": { "type": "integer" },
    "local_ts_us": { "type": "integer" },
    "is_snapshot": { "type": "boolean" },
    "side": { "enum": ["buy", "sell"] },
    "price": { "type": "number", "exclusiveMinimum": 0 },
    "qty": { "type": "number", "minimum": 0 }
  }
}

